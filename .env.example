# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Phase 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Signing secret of the connected-accounts endpoint (account.updated)
STRIPE_CONNECT_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-only key for Places API (New) autocomplete + place details.
# Addresses are resolved server-side so the state can never be typed by the user.
GOOGLE_MAPS_SERVER_API_KEY=

# Notifications (Phase 2/3)
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Background checks (Phase 3)
CHECKR_API_KEY=

# Phase 2
RESEND_FROM_EMAIL=LiftCrew <jobs@example.com>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Time zone for showing and filtering job times (launch state)
NEXT_PUBLIC_TIME_ZONE=America/New_York

# Phase 3
# Shared secret for the hourly /api/cron job (Vercel sends it automatically).
CRON_SECRET=
# TWILIO_PHONE_NUMBER may also be a Messaging Service SID (MG...).
